# ===== MeowHome Backend Environment Example =====
# Copy to .env and fill in real values. NEVER commit the real .env.

# --- Service ---
APP_ENV=development            # development | staging | production
APP_PORT=8080
APP_NAME=meowhome-backend
LOG_LEVEL=info                  # debug | info | warn | error
LOG_FORMAT=console              # console | json
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173

# --- Request limits ---
READ_TIMEOUT=15s
WRITE_TIMEOUT=30s
SHUTDOWN_TIMEOUT=15s
MAX_UPLOAD_SIZE_MB=20

# --- MySQL ---
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=123456
MYSQL_DATABASE=meowhome
MYSQL_TLS=false
MYSQL_MAX_OPEN_CONNS=50
MYSQL_MAX_IDLE_CONNS=10
MYSQL_CONN_MAX_LIFETIME=1h

# --- MySQL 集成测试（可选）---
# 仅在进程环境中显式设置后连接测试服务器；忽略 DSN 的数据库名。
# 每个测试创建唯一 meowhome_agent_test_<ULID>，只清理该测试创建的库。
# 也可显式设置 MYSQL_TEST_ENV_FILE 复用文件中的 MYSQL_* 凭据；DSN 优先。
# 账号需要 CREATE/DROP DATABASE 和 CREATE TRIGGER 权限，业务库不运行迁移/回滚。
# 两个入口均缺失则 SKIP；显式配置后的连接/权限失败会导致测试失败。
MYSQL_TEST_DSN=
MYSQL_TEST_ENV_FILE=

# --- Agent ---
# Agent 巡检独立于通用 AI 模型开关；默认关闭，启用前请先完成权限和数据库迁移验证。
AI_AGENT_ENABLED=false
AI_AGENT_LLM_ENHANCE=false
AI_AGENT_PATROL_TIMES=08:00,20:00
# 可选：逗号分隔的家庭 ID；留空表示全部家庭。仅限制新 Agent 写入，历史仍可读/忽略。
AI_AGENT_ALLOWED_FAMILIES=
# 普通巡检增强：1 个工作线程，队列 8 条，单条 5 秒；danger 永远使用规则模板。
# 首版仅允许原规则正文加已批准的说明，自由改写或新增事实会回退模板。
# 当前接口固定默认值（见 internal/app/agent_dto.go；尚未提供环境变量覆盖）：
# 消息分页默认 20、最多 50；聊天输入最多 2000 字符；历史 5 轮；
# 每轮模型请求最多 4 次、工具执行最多 8 次、总预算 25 秒；草稿有效期 24 小时。

# --- Auth ---
JWT_SECRET=replace-with-strong-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=720h            # 30 days
BCRYPT_COST=12

# --- File storage ---
STORAGE_DRIVER=local           # local | s3
STORAGE_LOCAL_DIR=./storage
STORAGE_BASE_URL=http://localhost:8080/static

# --- AI Provider (optional; absence disables AI features, not startup) ---
AI_ENABLED=false
# Chat Completions function-tools compatible endpoint root, e.g. https://provider.example/v1.
# Remote HTTP is rejected; use HTTPS. HTTP is allowed only for local development.
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT=30s
AI_MAX_RETRIES=2

# --- OCR Provider (optional) ---
OCR_ENABLED=false
OCR_BASE_URL=
OCR_API_KEY=
OCR_TIMEOUT=30s

# --- Redis (reserved, not required in MVP) ---
REDIS_ADDR=
REDIS_PASSWORD=
REDIS_DB=0

# --- Rate limit (in-process when Redis absent) ---
RATE_LIMIT_PER_MINUTE=120
