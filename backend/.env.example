# ===== MeowHome Backend Environment Example =====
# Copy to .env and fill in real values. NEVER commit the real .env.

# --- Service ---
APP_ENV=development            # development | staging | production
APP_PORT=8080
APP_NAME=meowhome-backend
LOG_LEVEL=info                  # debug | info | warn | error
LOG_FORMAT=console              # console | json
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173

# --- Request limits ---
READ_TIMEOUT=15s
WRITE_TIMEOUT=30s
SHUTDOWN_TIMEOUT=15s
MAX_UPLOAD_SIZE_MB=20

# --- MySQL ---
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=123456
MYSQL_DATABASE=meowhome
MYSQL_TLS=false
MYSQL_MAX_OPEN_CONNS=50
MYSQL_MAX_IDLE_CONNS=10
MYSQL_CONN_MAX_LIFETIME=1h

# --- Auth ---
JWT_SECRET=replace-with-strong-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=720h            # 30 days
BCRYPT_COST=12

# --- File storage ---
STORAGE_DRIVER=local           # local | s3
STORAGE_LOCAL_DIR=./storage
STORAGE_BASE_URL=http://localhost:8080/static

# --- AI Provider (optional; absence disables AI features, not startup) ---
AI_ENABLED=false
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT=30s
AI_MAX_RETRIES=2

# --- OCR Provider (optional) ---
OCR_ENABLED=false
OCR_BASE_URL=
OCR_API_KEY=
OCR_TIMEOUT=30s

# --- Redis (reserved, not required in MVP) ---
REDIS_ADDR=
REDIS_PASSWORD=
REDIS_DB=0

# --- Rate limit (in-process when Redis absent) ---
RATE_LIMIT_PER_MINUTE=120
